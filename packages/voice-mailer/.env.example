# Klucz API OpenAI używany do transkrypcji nagrań
OPENAI_API_KEY=

# Konfiguracja serwera SMTP używanego do wysyłki e-maili
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Adres nadawcy i odbiorcy wiadomości
SENDER_EMAIL=
TARGET_EMAIL=

# Port HTTP, na którym ma działać aplikacja (opcjonalny)
PORT=3000
